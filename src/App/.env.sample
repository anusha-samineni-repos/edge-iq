# Edge IQ console - local development
#
# Only needed when running `npm run dev` outside a container. In production the
# console is served by nginx, which proxies /api to the API container, so the
# browser never needs to know the API address.

# Where the Vite dev server proxies /api. Point this at your local API
# (uvicorn app:app --port 8000) or at a deployed Container App FQDN.
VITE_API_BASE=http://localhost:8000
